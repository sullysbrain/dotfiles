" ============================================================
"  Vim configuration — Tokyo Night-inspired dark color scheme
"  Matched from screenshot palette
"  Author: Generated for Digital Blacksmiths
" ============================================================

" 4 space tab setting
autocmd FileType python setlocal \
    expandtab \
    tabstop=4 \
    shiftwidth=4 \
    softtabstop=4 \
    autoindent \
    smartindent

" --- Core Settings ---
set termguicolors        " Enable 24-bit RGB color in the TUI
" set background=dark
syntax enable
set number               " Show line numbers

" Disable cursorline completely — no horizontal highlight bar
set nocursorline
set nocursorcolumn

" ============================================================
"  Color Palette (Tokyo Night / screenshot-matched)
"
"  Background  #2a2f3a   VS Code Nord custom dark
"  Foreground  #d8dee9   Nord Snow Storm
"  LineNr      #4c566a   Nord Polar Night (dim)
"  LineNrActive #468484  VS Code Nord custom active
"  Comment     #434c5e   Nord muted blue-gray
"  Keyword     #81a1c1   Nord Frost blue
"  Function    #88c0d0   Nord Frost light blue
"  Type        #8fbcbb   Nord Frost teal
"  String      #a3be8c   Nord Aurora green
"  Number      #b48ead   Nord Aurora purple
"  Special     #ebcb8b   Nord Aurora yellow
"  Error       #bf616a   Nord Aurora red
" ============================================================

hi clear
if exists("syntax_on")
  syntax reset
endif
let g:colors_name = "tokyonight_screenshot"

" --- Base UI ---
hi Normal           guifg=#d8dee9  guibg=#2a2f3a  gui=NONE
hi NonText          guifg=#4c566a  guibg=#2a2f3a  gui=NONE
hi EndOfBuffer      guifg=#4c566a  guibg=#2a2f3a  gui=NONE
hi ColorColumn      guifg=NONE     guibg=#2e3440  gui=NONE
hi Conceal          guifg=#434c5e  guibg=NONE     gui=NONE

" --- Line Numbers ---
