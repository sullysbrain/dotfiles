hi CursorLineNr     guifg=#468484  guibg=#2a2f3a  gui=NONE

" --- Cursor Line: explicitly disabled (no bar, no underline) ---
hi CursorLine       guibg=NONE     gui=NONE       cterm=NONE
hi CursorColumn     guibg=NONE     gui=NONE       cterm=NONE

" --- Sign Column ---
hi SignColumn       guifg=#4c566a  guibg=#2a2f3a  gui=NONE

" --- Splits and Borders ---
